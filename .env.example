# Copy to .env to override defaults. No API keys are needed: both APIs are public.
# Never commit .env.

# Identify yourself to the API providers (appended to the User-Agent header).
# Use an address or URL where they can reach you.
JOBINTEL_CONTACT=

# Where raw snapshots (data/raw) and exports (data/processed) are written.
# JOBINTEL_DATA_DIR=data

# Politeness / robustness knobs (defaults shown)
# JOBINTEL_REQUEST_DELAY_S=2.0
# JOBINTEL_CONNECT_TIMEOUT_S=5
# JOBINTEL_READ_TIMEOUT_S=30
# JOBINTEL_MAX_RETRIES=2
# JOBINTEL_ARBEITNOW_MAX_PAGES=10

# A source is re-fetched only when its newest raw snapshot is older than this.
# Remotive asks for at most ~4 requests/day, so the default is 6 hours.
# JOBINTEL_ARBEITNOW_TTL_H=1
# JOBINTEL_REMOTIVE_TTL_H=6

# --- Phase 2: semantic search -------------------------------------------------
# JOBINTEL_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# JOBINTEL_DEVICE=cpu
# JOBINTEL_CHUNK_MAX_TOKENS=300
# JOBINTEL_CHUNK_OVERLAP_TOKENS=40
# JOBINTEL_EVAL_DIR=eval
